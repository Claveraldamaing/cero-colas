# Copiar como .env, fuera del control de versiones. Windows: usar scripts/setup-local.ps1.
DATABASE_URL=postgresql+psycopg2://cerocolas:REPLACE_ME@127.0.0.1:55432/cerocolas_p1
ENVIRONMENT=development
COOKIE_SECURE=false
FRONTEND_URL=http://127.0.0.1:5173
HOSPITAL_MODE=simulator
HOSPITAL_API_BASE_URL=http://127.0.0.1:4010
HOSPITAL_CLIENT_ID=simulator
HOSPITAL_CLIENT_SECRET=simulator-only-not-a-real-secret
# Generar con scripts/setup-local.ps1. No reutilizar ni compartir esta clave.
CITA_ENCRYPTION_KEY=
# Hospital real: credenciales entregadas por TI; no usar las del simulador.
HOSPITAL_PRIVACY_POLICY_APPROVED=false
HOSPITAL_PRIVACY_POLICY_TEXT=
# En el simulador local se puede probar la reserva sin esta regla (nunca es real).
# En modo hospital, configurar solo cuando Admisión confirme la vigencia.
# REFERENCE_MAX_AGE_DAYS=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_STARTTLS=true
